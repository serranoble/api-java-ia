meta {
  name: 03 - Create Invalid Product - 400 (POST)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: none
}

body:json {
  {
    "gtin": "abc",
    "name": "",
    "description": "Debe fallar con errores de validación por campo",
    "price": -5
  }
}

tests {
  test("Status 400 Bad Request con fieldErrors", function() {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body.fieldErrors).to.be.an("object");
    expect(body.fieldErrors.gtin).to.be.a("string");
    expect(body.fieldErrors.name).to.be.a("string");
    expect(body.fieldErrors.price).to.be.a("string");
  });
}
