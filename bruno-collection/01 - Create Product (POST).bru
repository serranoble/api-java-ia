meta {
  name: 01 - Create Product (POST)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: none
}

body:json {
  {
    "gtin": "7800007807939",
    "name": "Café Molido Premium 500g",
    "description": "Café arábica tostado y molido, envase sellado al vacío.",
    "price": 12.50
  }
}

tests {
  test("Status 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Devuelve todos los campos del producto", function() {
    const body = res.getBody();
    expect(body.gtin).to.equal(bru.getEnvVar("gtin"));
    expect(body.name).to.equal("Café Molido Premium 500g");
    expect(body.price).to.equal(12.5);
  });
}
